extends Node
## Автозагрузка: глобальное состояние оформления игры.
## Хранит выбранный режим фона (Light/Dark) и последний показанный флажок,
## чтобы эти настройки сохранялись между переходами по сценам.

## Испускается при переключении режима фона.
signal mode_changed(is_dark: bool)

## Текущий режим фона. По умолчанию — Light.
var is_dark: bool = false

## Индекс флажка, показанного последним в главном меню.
## -1 значит «ещё не выбирали» — тогда подойдёт любой флажок.
var flag_index: int = -1


func toggle_mode() -> void:
	is_dark = not is_dark
	mode_changed.emit(is_dark)
